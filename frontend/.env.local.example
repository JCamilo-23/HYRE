# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App (OAuth callback base URL — must match Supabase Redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth providers (local Supabase CLI only — production secrets go in Supabase Dashboard)
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=
# SUPABASE_AUTH_APPLE_CLIENT_ID=
# SUPABASE_AUTH_APPLE_SECRET=
# SUPABASE_AUTH_LINKEDIN_CLIENT_ID=
# SUPABASE_AUTH_LINKEDIN_SECRET=

# AI / Video Analysis
OPENAI_API_KEY=your-openai-key

# Stripe (billing)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=re_...
