# Supabase — REQUERIDO para login OAuth (Google, Apple, LinkedIn)
# NO uses placeholder.supabase.co (no existe y OAuth falla con ERR_NAME_NOT_RESOLVED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App (OAuth callback — debe coincidir con Supabase Redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API (FastAPI + Gemini)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Gemini — solo servidor Next.js (ruta /api/nova/chat). NO usar NEXT_PUBLIC_
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# OAuth providers (solo Supabase CLI local — en producción van en el Dashboard)
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=
# SUPABASE_AUTH_APPLE_CLIENT_ID=
# SUPABASE_AUTH_APPLE_SECRET=
# SUPABASE_AUTH_LINKEDIN_CLIENT_ID=
# SUPABASE_AUTH_LINKEDIN_SECRET=

# AI / Video Analysis
OPENAI_API_KEY=your-openai-key

# Stripe (billing)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=re_...
